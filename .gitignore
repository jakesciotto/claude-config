# temp files
.DS_Store

# keep projects local
projects/*
global/_shared

# deprecated commands kept locally, outside the loaded command tree
global/commands-archive/

# references: track the dir, never the contents (may hold customer data / PII)
global/references/*
!global/references/.gitkeep

# posthog-internal skills/material (internal table names, customer-adjacent queries)
posthog/

# python bytecode
__pycache__/
*.pyc
