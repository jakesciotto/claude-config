{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_METRIC_EXPORT_INTERVAL": "30000"
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "TodoWrite(*)",
      "TaskOutput(*)",
      "TaskStop(*)",
      "NotebookEdit(*)",
      "WebSearch(*)",
      "mcp__claude_ai_PostHog__exec"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(npm publish:*)",
      "Bash(eval:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Glob(*)",
      "Grep(*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/auto-trust-folder.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-summary.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/usr/bin/python3 \"$HOME/.claude/scripts/statusline-usage.py\""
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "posthog@claude-plugins-official": false,
    "caveman@caveman": true,
    "todoist@doist": false,
    "supabase@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "hogpilot@hogpilot": true
  },
  "extraKnownMarketplaces": {
    "PostHog-skills": {
      "source": {
        "source": "github",
        "repo": "PostHog/skills"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "doist": {
      "source": {
        "source": "github",
        "repo": "doist/todoist-mcp"
      }
    },
    "hogpilot": {
      "source": {
        "source": "directory",
        "path": "/Users/jakesciotto/github/hogpilot"
      }
    }
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "notifications_disabled",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "promptSuggestionEnabled": false,
  "skillOverrides": {
    "user-deep-dive": "off",
    "posthog-debugger": "off",
    "posthog-survey-creator": "off"
  }
}
