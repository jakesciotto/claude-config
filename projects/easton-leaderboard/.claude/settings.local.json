{
  "permissions": {
    "allow": [
      "Bash(npx shadcn@latest:*)",
      "Bash(node:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sync-version.sh",
            "timeout": 10,
            "statusMessage": "Syncing version files"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/update-changelog.sh",
            "timeout": 10,
            "statusMessage": "Updating changelog"
          }
        ]
      }
    ]
  }
}
